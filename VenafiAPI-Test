param(
    [string]$BaseUrl,
    [string]$Username,
    [string]$Password,
    [securestring]$SecurePassword,
    [switch]$SkipTlsVerify
)

function Show-CredentialForm {
    Add-Type -AssemblyName System.Windows.Forms
    Add-Type -AssemblyName System.Drawing

    $form = New-Object System.Windows.Forms.Form
    $form.Text = "TPP API Login"
    $form.Size = New-Object System.Drawing.Size(350,200)
    $form.StartPosition = "CenterScreen"

    # Labels
    $lblUrl = New-Object System.Windows.Forms.Label
    $lblUrl.Text = "Base URL:"
    $lblUrl.Location = '10,20'
    $lblUrl.AutoSize = $true
    $form.Controls.Add($lblUrl)

    $lblUser = New-Object System.Windows.Forms.Label
    $lblUser.Text = "Username:"
    $lblUser.Location = '10,55'
    $lblUser.AutoSize = $true
    $form.Controls.Add($lblUser)

    $lblPass = New-Object System.Windows.Forms.Label
    $lblPass.Text = "Password:"
    $lblPass.Location = '10,90'
    $lblPass.AutoSize = $true
    $form.Controls.Add($lblPass)

    # Textboxes
    $txtUrl = New-Object System.Windows.Forms.TextBox
    $txtUrl.Location = '100,18'
    $txtUrl.Width = 200
    $form.Controls.Add($txtUrl)

    $txtUser = New-Object System.Windows.Forms.TextBox
    $txtUser.Location = '100,53'
    $txtUser.Width = 200
    $form.Controls.Add($txtUser)

    $txtPass = New-Object System.Windows.Forms.TextBox
    $txtPass.Location = '100,88'
    $txtPass.Width = 200
    $txtPass.UseSystemPasswordChar = $true
    $form.Controls.Add($txtPass)

    # OK button
    $okButton = New-Object System.Windows.Forms.Button
    $okButton.Text = "OK"
    $okButton.Location = '100,125'
    $okButton.Add_Click({
        $form.Tag = @{
            BaseUrl  = $txtUrl.Text
            Username = $txtUser.Text
            Password = $txtPass.Text
        }
        $form.Close()
    })
    $form.Controls.Add($okButton)

    # Cancel button
    $cancelButton = New-Object System.Windows.Forms.Button
    $cancelButton.Text = "Cancel"
    $cancelButton.Location = '200,125'
    $cancelButton.Add_Click({ $form.Tag = $null; $form.Close() })
    $form.Controls.Add($cancelButton)

    $form.ShowDialog() | Out-Null
    return $form.Tag
}

# If no parameters provided, show GUI
if (-not $BaseUrl -or -not $Username -or (-not $Password -and -not $SecurePassword)) {
    $input = Show-CredentialForm
    if (-not $input) {
        Write-Host "User cancelled input."
        exit 1
    }
    $BaseUrl  = $input.BaseUrl
    $Username = $input.Username
    $Password = $input.Password
}

# Convert plain password to SecureString if needed
if (-not $SecurePassword -and $Password) {
    $SecurePassword = ConvertTo-SecureString $Password -AsPlainText -Force
}

# Optional: skip TLS validation
if ($SkipTlsVerify) {
    add-type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
    [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy
}

# --- Your existing verification logic here ---
Write-Host "Authenticating to $BaseUrl as $Username ..."
# Example placeholder:
try {
    # Example: simulate API call
    Start-Sleep -Seconds 1
    Write-Host "PASS: OAuth succeeded. Access token acquired."
    Write-Host "PASS: API call succeeded."
    exit 0
}
catch {
    Write-Host "FAIL: $($_.Exception.Message)"
    exit 2
}
